
---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			article {
				width: 100%;
				margin: 0;
				padding: 0 0 5rem;
			}

			.article-header {
				padding: 3rem 12vw 2rem;
				max-width: 100%;
			}

			.category {
				margin: 0 0 1rem;
				font-size: 1rem;
				line-height: 1.3;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}

			.title {
				max-width: 1100px;
				margin: 0 0 1.5rem;
				font-size: clamp(2.8rem, 7vw, 5.5rem);
				font-weight: 400;
				line-height: 1.05;
				text-align: left;
			}

			.description {
				max-width: 800px;
				margin: 0 0 1.5rem;
				font-size: 1.5rem;
				line-height: 1.4;
			}

			.date {
				margin: 0 0 1.5rem;
				font-size: 1.1rem;
				line-height: 1.5;
			}

			.last-updated-on {
				margin-top: 0.25rem;
				font-style: italic;
			}

			/* Cover image */
			.hero-image {
				width: calc(100% - 3rem);
				max-width: 900px;
				margin: 0 auto 2rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				max-height: none;
				object-fit: unset;
			}

			/* Main article text */
			.prose {
				width: 100%;
				max-width: 760px;
				margin: 0 auto;
				padding: 0 1.5rem;
				color: var(--red);
				font-size: 1.3rem;
				line-height: 1.7;
			}

			.prose :global(p) {
				margin: 0 0 1.5rem;
			}

			/* Image captions */
			.prose :global(.caption) {
				font-size: 1.1rem !important;
				line-height: 1.5;
				font-style: italic;
				margin: 0.5rem 0 0;
			}

			/* Two images side by side */
			.prose :global(.image-pair) {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.5rem;
				width: 100%;
				margin: 2rem 0;
				align-items: start;
			}

			.prose :global(.image-pair figure) {
				min-width: 0;
				margin: 0;
			}

			.prose :global(.image-pair img) {
				display: block;
				width: 100%;
				max-width: 100%;
				height: auto;
				margin: 0;
				object-fit: contain;
			}

			.prose :global(.image-pair .caption) {
				margin-top: 0.5rem;
			}

			.prose :global(h2) {
				margin: 3rem 0 1rem;
				font-size: 2.4rem;
				line-height: 1.2;
				font-weight: 400;
			}

			.prose :global(h3) {
				margin: 2.5rem 0 0.75rem;
				font-size: 1.8rem;
				line-height: 1.3;
				font-weight: 400;
			}

			.prose :global(h4) {
				margin: 2rem 0 0.75rem;
				font-size: 1.4rem;
				line-height: 1.4;
				font-weight: 600;
			}

			.prose :global(a) {
				color: var(--red);
				text-decoration: underline;
				text-underline-offset: 0.15em;
			}

			.prose :global(a:hover) {
				color: var(--text);
			}

			/* Individual images in the article */
			.prose :global(img) {
				display: block;
				width: auto;
				max-width: 100%;
				height: auto;
				object-fit: contain;
				margin: 2rem auto;
			}

			.prose :global(figure) {
				margin: 2rem 0;
			}

			.prose :global(figcaption) {
				margin-top: 0.5rem;
			}

			.prose :global(blockquote) {
				margin: 2rem 0;
				padding: 0 0 0 1.25rem;
				border-left: 3px solid var(--red);
				font-size: 1.4rem;
				line-height: 1.5;
			}

			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 1.5rem;
				padding-left: 1.5rem;
			}

			.prose :global(li) {
				margin-bottom: 0.5rem;
			}

			.prose :global(hr) {
				margin: 2rem 0;
				border: 0;
				border-top: 1px solid var(--red);
			}

			.back-link {
				max-width: 760px;
				margin: 3rem auto 0;
				padding: 0 1.5rem;
			}

			.back-link a {
				color: var(--red);
				text-decoration: underline;
				text-underline-offset: 0.15em;
			}

			.back-link a:hover {
				color: var(--text);
			}

			@media (max-width: 700px) {
				article {
					padding-bottom: 3rem;
				}

				.article-header {
					padding: 2rem 1.5rem 1.5rem;
				}

				.title {
					font-size: clamp(2.5rem, 11vw, 4rem);
				}

				.description {
					font-size: 1.3rem;
				}

				.prose {
					font-size: 1.15rem;
					padding: 0 1.5rem;
				}

				.prose :global(h2) {
					font-size: 2rem;
				}

				.prose :global(h3) {
					font-size: 1.6rem;
				}

				.prose :global(.image-pair) {
					gap: 0.75rem;
				}

				.prose :global(.image-pair .caption) {
					font-size: 0.95rem !important;
					line-height: 1.4;
				}

				.hero-image {
					width: calc(100% - 2.5rem);
					margin-bottom: 2rem;
				}

				.back-link {
					padding: 0 1.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<article>
				<header class="article-header">
					{category && <p class="category">{category}</p>}

					<h1 class="title">{title}</h1>

					{description && (
						<p class="description">{description}</p>
					)}

					<div class="date">
						<FormattedDate date={pubDate} />

						{updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)}
					</div>

					<hr />
				</header>

				{heroImage && (
					<div class="hero-image">
						<Image src={heroImage} alt={title} />
					</div>
				)}

				<div class="prose">
					<slot />
				</div>

				<div class="back-link">
					<a href="/blog/">← Back to all articles</a>
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>
