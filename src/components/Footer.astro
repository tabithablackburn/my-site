
---
const year = new Date().getFullYear();
---

<footer>
        <div class="top">
                <div class="contact">
                        <p class="contact-heading">Email</p>

                        <div class="contact-item">
                                <p class="contact-label">UCL</p>
                                <p class="line"><a href="mailto:tabitha.blackburn.26@ucl.ac.uk">tabitha.blackburn.26@ucl.ac.uk</a></p>
                        </div>

                        <div class="contact-item">
                                <p class="contact-label">V&amp;A</p>
                                <p class="line"><a href="mailto:t.blackburn@vam.ac.uk">t.blackburn@vam.ac.uk</a></p>
                        </div>
                </div>

                <div class="social-section">
                        <p class="social-heading">Social</p>

                        <div class="social">
                                <a href="https://profiles.ucl.ac.uk/110546-tabitha-blackburn" aria-label="UCL profile">
                                        <img src="/ucl-logo.png" alt="" />
                                </a>

                                <a href="https://www.instagram.com/tabitha.design.notes/?hl=en" aria-label="Instagram">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"></rect>
                                                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
                                                <circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"></circle>
                                        </svg>
                                </a>

                                <a href="https://www.linkedin.com/in/tabitha-blackburn-a1b27828a/?isSelfProfile=true" aria-label="LinkedIn">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                                        </svg>
                                </a>

                                <a href="https://substack.com/@tabithablackburn" aria-label="Substack">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path fill="currentColor" d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"></path>
                                        </svg>
                                </a>
                        </div>
                </div>
        </div>

        <p class="copyright">&copy; {year} Tabitha Blackburn.</p>
</footer>

<style>
        footer {
                margin: 0;
                padding: 3rem 12vw 2rem;
                background: #960714;
                color: #fff58f;
                text-align: left;
        }

        .top {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 2rem;
                flex-wrap: wrap;
        }

        .contact-heading,
        .social-heading {
                margin: 0 0 1.2rem 0;
                font-size: 1.4rem;
                font-weight: 600;
        }

        .contact-item {
                margin-bottom: 1rem;
        }

        .contact-label {
                margin: 0 0 0.2rem 0;
                font-size: 1rem;
                font-weight: 600;
        }

        .line {
                margin: 0;
                font-size: 1.2rem;
                line-height: 1.4;
                overflow-wrap: anywhere;
        }

        footer a,
        footer a:hover {
                color: #fff58f;
                text-decoration: none;
        }

        .line a:hover {
                text-decoration: underline;
        }

        .social {
                display: flex;
                align-items: center;
                gap: 1.25rem;
                transform: translate(-0.80rem, -3rem);
        }

        .social a {
                display: block;
                width: 2.6rem;
                height: 2.6rem;
                flex-shrink: 0;
        }

        .social a:first-child {
                width: 8.5rem;
                height: 8.5rem;
                margin-right: -0.5rem;
        }

        .social svg,
        .social img {
                display: block;
                width: 100%;
                height: 100%;
        }

        .social img {
                object-fit: contain;
        }

        .social a:hover {
                opacity: 0.75;
        }

        .copyright {
                margin: 3rem 0 0 0;
                font-size: 1.1rem;
        }

        @media (max-width: 700px) {
                footer {
                        padding: 2.5rem 1.5rem 1.5rem;
                }

                .line {
                        font-size: 1.1rem;
                }
        }
</style>
