---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const categories = ['20th Century', 'Set Decoration'];

const filmTitles = [
    'The Moonwalkers: A Journey with Tom Hanks',
    '2001: A Space Odyssey',
    'Wuthering Heights',
    'Barbarella',
];

/* Match film titles, longest first. */
const filmTitlePattern = new RegExp(
    '(' +
        filmTitles
            .slice()
            .sort((a, b) => b.length - a.length)
            .join('|') +
        ')',
    'gi'
);

const allPosts = await getCollection('blog');

allPosts.sort(function (a, b) {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const items = allPosts.map(function (post) {
    return {
        href: '/blog/' + post.id + '/',
        title: post.data.title,
        titleParts: post.data.title.split(filmTitlePattern),
        summary: post.data.description,
        summaryParts: post.data.description
            ? post.data.description.split(filmTitlePattern)
            : [],
        category: post.data.category || '',
        image: post.data.heroImage ? post.data.heroImage.src : '',
        date: post.data.pubDate.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
        }),
    };
});

function isFilmTitle(part: string) {
    return filmTitles.some(
        (film) => film.toLowerCase() === part.toLowerCase()
    );
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title="Writing | Tabitha Blackburn"
            description="Essays and research on decorative arts, furniture and interiors."
        />

        <style>
            .writing {
                padding: 3rem 12vw 7rem;
            }

            .writing h1 {
                font-size: clamp(3.5rem, 9vw, 7rem);
                line-height: 1;
                margin: 0 0 2rem 0;
            }

            .tabs {
                display: flex;
                gap: 2rem;
                flex-wrap: wrap;
                margin-bottom: 3rem;
            }

            .tab {
                background: none;
                border: none;
                border-bottom: 2px solid transparent;
                padding: 0 0 0.2rem 0;
                font-family: inherit;
                font-size: 1.5rem;
                color: #960714;
                cursor: pointer;
            }

            .tab:hover,
            .tab.active {
                border-bottom-color: #960714;
            }

            .grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 3rem 2.5rem;
                list-style: none;
                margin: 0;
                padding: 0;
                align-items: start;
            }

            .item[hidden] {
                display: none;
            }

            .item a {
                display: block;
                text-decoration: none;
            }

            .item img {
                display: block;
                width: 100%;
                height: auto;
                aspect-ratio: auto;
                object-fit: contain;
                border-radius: 0;
                margin-bottom: 1rem;
            }

            .meta {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                margin-bottom: 0.6rem;
                font-size: 1.05rem;
            }

            .pill {
                background: #e9c77f;
                border-radius: 999px;
                padding: 0.15rem 0.9rem;
                font-size: 1.05rem;
            }

            .item h2 {
                font-size: 1.9rem;
                line-height: 1.2;
                margin: 0 0 0.6rem 0;
            }

            .item .summary {
                font-size: 1.15rem;
                line-height: 1.5;
                margin: 0;
            }

            .empty {
                font-style: italic;
            }

            @media (max-width: 1000px) {
                .grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (max-width: 700px) {
                .writing {
                    padding: 2rem 1.5rem 5rem;
                }

                .grid {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </head>

    <body>
        <Header />

        <main>
            <section class="writing">
                <h1>All Posts</h1>

                <div class="tabs">
                    <button class="tab active" data-cat="all">All Posts</button>

                    {categories.map((cat) => (
                        <button class="tab" data-cat={cat}>{cat}</button>
                    ))}
                </div>

                <ul class="grid">
                    {items.map((item) => (
                        <li class="item" data-cat={item.category}>
                            <a href={item.href}>
                                {item.image && <img src={item.image} alt="" />}

                                <div class="meta">
                                    <span>{item.date}</span>
                                    {item.category && (
                                        <span class="pill">{item.category}</span>
                                    )}
                                </div>

                                <h2>
                                    {item.titleParts.map((part) =>
                                        isFilmTitle(part) ? (
                                            <em>{part}</em>
                                        ) : (
                                            part
                                        )
                                    )}
                                </h2>

                                <p class="summary">
                                    {item.summaryParts.map((part) =>
                                        isFilmTitle(part) ? (
                                            <em>{part}</em>
                                        ) : (
                                            part
                                        )
                                    )}
                                </p>
                            </a>
                        </li>
                    ))}
                </ul>

                <p class="empty" id="empty" hidden>
                    No posts in this category yet.
                </p>
            </section>
        </main>

        <Footer />

        <script>
            const tabs = document.querySelectorAll('.tab');
            const cards = document.querySelectorAll('.item');
            const empty = document.getElementById('empty');

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    const cat = tab.getAttribute('data-cat');
                    let shown = 0;

                    tabs.forEach(function (t) {
                        t.classList.remove('active');
                    });

                    tab.classList.add('active');

                    cards.forEach(function (card) {
                        const show =
                            cat === 'all' ||
                            card.getAttribute('data-cat') === cat;

                        card.hidden = !show;

                        if (show) shown++;
                    });

                    if (empty) empty.hidden = shown > 0;
                });
            });
        </script>
    </body>
</html>