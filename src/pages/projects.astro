
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
				<BaseHead
			title="Projects | Tabitha Blackburn"
			description="Other writing, research and related projects."
		/>
		<style>
			.layout {
				padding: 3rem 12vw 7rem;
			}
			.layout h1 {
				font-size: clamp(3.5rem, 9vw, 7rem);
				line-height: 1;
				margin: 0 0 2rem 0;
			}
			.layout h2 {
				font-size: 2.4rem;
				line-height: 1.2;
				margin: 3rem 0 1.5rem 0;
				padding-top: 1rem;
				border-top: 1px solid #960714;
			}
			.layout h3 {
				font-size: 1.8rem;
				line-height: 1.3;
				margin: 2rem 0 1rem 0;
			}
			.layout h4 {
				font-size: 1.4rem;
				line-height: 1.4;
				margin: 1.75rem 0 0.75rem 0;
			}
			.layout p,
			.layout li {
				font-size: 1.2rem;
				line-height: 1.6;
			}
			.layout p {
				margin: 0 0 1rem 0;
			}
			.layout ul {
				padding-left: 1.5rem;
				margin: 0 0 1.5rem 0;
			}
			.layout li {
				margin-bottom: 0.6rem;
			}
			.layout a {
				color: #960714;
				text-decoration: underline;
				text-underline-offset: 0.15em;
			}
			.layout a:hover {
				color: #2a1a1a;
			}
			@media (max-width: 700px) {
				.layout {
					padding: 2rem 1.5rem 5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="layout">
				<h1>Projects</h1>

				<h2>V&amp;A Blog</h2>

				<p>
					Tabitha Blackburn, ‘<a href="https://www.vam.ac.uk/blog/museum-life/borrow-adapt-combine-improvising-chinese-landscape-scenes-in-late-seventeenth-century-london?srsltid=AfmBOoqjw1jITFgVo3w8iW_EntdSOiNs_PvO1xeBIAoJP1T2t4Jy5-1w">Borrow, Adapt, Combine: Improvising Chinese landscape scenes in late seventeenth-century London</a>’, <em>V&amp;A Blog</em>, 30 July 2024 [accessed 8 January 2026].
				</p>

