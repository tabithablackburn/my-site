---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');

allPosts.sort(function (a, b) {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const filmTitles = [
    'The Moonwalkers: A Journey with Tom Hanks',
    '2001: A Space Odyssey',
    'Wuthering Heights',
    'Barbarella',
];

const filmTitlePattern = new RegExp(
    '(' +
        filmTitles
            .slice()
            .sort((a, b) => b.length - a.length)
            .join('|') +
        ')',
    'gi'
);

const items = allPosts.slice(0, 3).map(function (post) {
    return {
        href: '/blog/' + post.id + '/',
        title: post.data.title,
        image: post.data.heroImage ? post.data.heroImage.src : '',
        date: post.data.pubDate.toLocaleDateString('en-GB', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
        }),
    };
});
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

        <style>
            /* Show the complete latest-post images without cropping. */
            .cards .card img {
                display: block;
                width: 100%;
                height: auto;
                aspect-ratio: auto;
                object-fit: contain;
            }
        </style>
    </head>

    <body>
        <Header />

        <main>
            <section class="intro">
                <h1>Tabitha Blackburn</h1>

                <p>
                    I research and write about craft, design, interior, and architectural history, focusing on the late seventeenth, early eighteenth, and twentieth centuries. I am currently working on an AHRC-funded collaborative PhD at the Victoria and Albert Museum (V&A) and UCL (Department of Information Studies).
                </p>
            </section>

            <section class="latest">
                <h2>Latest Posts</h2>

                <ul class="cards">
                    {items.map((item) => {
                        const titleParts = item.title.split(filmTitlePattern);

                        return (
                            <li class="card">
                                <a href={item.href}>
                                    {item.image && (
                                        <img src={item.image} alt="" />
                                    )}

                                    <h3>
                                        {titleParts.map((part) =>
                                            filmTitles.some(
                                                (film) =>
                                                    film.toLowerCase() ===
                                                    part.toLowerCase()
                                            ) ? (
                                                <em>{part}</em>
                                            ) : (
                                                part
                                            )
                                        )}
                                    </h3>

                                    <p class="date">{item.date}</p>
                                </a>
                            </li>
                        );
                    })}
                </ul>

                <p class="more">
                    <a href="/blog">All Posts &rarr;</a>
                </p>
            </section>
        </main>

        <Footer />
    </body>
</html>